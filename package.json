{
  "name": "study-life",
  "private": true,
  "version": "1.12.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --configLoader native && node scripts/check-release-build.mjs dist",
    "build:check": "node scripts/build-check.mjs",
    "check:release": "npm run build",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --maxWorkers=2",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:ratchet": "node scripts/typecheck-ratchet.mjs",
    "typecheck:report": "node scripts/typecheck-ratchet.mjs --report",
    "check": "npm run check:release-readme && npm run pages:verify-config && npm run worker:check && npm run lint && npm run typecheck && npm run typecheck:ratchet && npm test && npm run build:check",
    "release:bump": "node scripts/bump-release.mjs",
    "release:sync-versions": "node scripts/sync-release-versions.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:release": "node scripts/audit/release-integrity.mjs https://study-life.pages.dev",
    "audit:first-visit": "node scripts/audit/first-visit.mjs https://study-life.pages.dev",
    "audit:reload-loop": "node scripts/audit/reload-loop.mjs dist",
    "audit:iphone-boot": "node scripts/audit/iphone-boot.mjs https://study-life.pages.dev",
    "deploy:production": "node scripts/deploy-production.mjs",
    "build:desktop": "vite build --configLoader native --mode desktop && node scripts/check-release-build.mjs dist-desktop",
    "desktop:install-deps": "npm ci --prefix desktop-app",
    "desktop:dev": "npm run desktop:install-deps && npm run build:desktop && electron .",
    "desktop:dir": "npm run desktop:install-deps && npm run build:desktop && electron-builder --config electron-builder.yml --dir --win --x64 --publish never",
    "desktop:verify": "node scripts/verify-desktop-package.mjs",
    "desktop:installer": "npm run desktop:install-deps && npm run build:desktop && electron-builder --config electron-builder.release.yml --win nsis --x64 --publish never && node scripts/verify-desktop-package.mjs --require-signature",
    "supabase:verify-config": "node scripts/verify-supabase-config.mjs",
    "supabase:verify-bundle": "node scripts/verify-supabase-bundle.mjs",
    "pages:verify-config": "node scripts/verify-pages-config.mjs",
    "worker:check": "node scripts/check-public-worker.mjs",
    "worker:deploy": "node scripts/deploy-public-worker.mjs",
    "storage:free-limit": "node scripts/configure-free-storage.mjs",
    "auth:inspect": "node scripts/inspect-auth-capabilities.mjs",
    "check:release-readme": "node scripts/check-release-readme.mjs"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "1.48.0",
    "@supabase/supabase-js": "2.117.2",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "2.10.5",
    "semver": "6.3.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "vue": "3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "44.6.0",
    "electron-builder": "26.17.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "4.149.0"
  },
  "main": "desktop-app/main.cjs"
}
