.page{padding:24rpx 28rpx 70rpx}.intro{display:grid;gap:10rpx;padding:20rpx 0 24rpx}.eyebrow{font-size:24rpx;letter-spacing:2rpx;color:var(--primary)}.title{font-size:42rpx;font-weight:750;color:var(--text)}.copy{font-size:24rpx;line-height:1.7;color:var(--muted)}.form{display:grid;gap:14rpx;padding:20rpx;border:1rpx solid var(--border);border-radius:20rpx;background:var(--card)}.form-title{font-size:28rpx;font-weight:650}.picker{padding:16rpx 12rpx;background:var(--bg);border-radius:12rpx;font-size:24rpx;color:var(--muted)}.form input,.form textarea{box-sizing:border-box;width:100%;padding:16rpx;border:1rpx solid var(--border);border-radius:12rpx;background:var(--card);font-size:24rpx;color:var(--text)}.form textarea{min-height:180rpx}.privacy{font-size:24rpx;line-height:1.7;color:var(--muted)}.primary{background:var(--primary);color:#fff;border-radius:14rpx;font-size:25rpx}.notice{margin-top:14rpx;padding:14rpx;border-radius:12rpx;font-size:24rpx}.error{background:#f9ecea;color:#9c4038}.success{background:#e6f3ed;color:var(--primary)}.section-heading{display:flex;justify-content:space-between;align-items:center;margin:32rpx 2rpx 10rpx;font-size:28rpx;font-weight:650}.filter{color:var(--primary);font-size:24rpx}.state{padding:50rpx 10rpx;color:var(--muted);text-align:center;font-size:24rpx}.list{border-top:1rpx solid var(--border)}.item{display:grid;gap:12rpx;padding:20rpx 2rpx;border-bottom:1rpx solid var(--border)}.meta{display:flex;align-items:center;gap:12rpx;color:var(--muted);font-size:24rpx}.status{padding:4rpx 10rpx;border-radius:99rpx;background:var(--primary-soft);color:var(--primary)}.item-title{font-size:26rpx;font-weight:650;color:var(--text)}.item-body{white-space:pre-wrap;overflow-wrap:anywhere;font-size:24rpx;line-height:1.7;color:var(--muted)}.reply{display:grid;gap:5rpx;padding:14rpx;border-left:5rpx solid var(--primary);background:var(--bg);color:var(--muted);font-size:24rpx;line-height:1.7;white-space:pre-wrap}.reply-title{font-weight:650;color:var(--text)}
.reward{padding:10rpx 13rpx;border-radius:10rpx;background:#e6f3ed;color:var(--primary);font-size:24rpx;font-weight:650}.pagination{display:flex;align-items:center;gap:16rpx;margin:24rpx 0;color:var(--muted);font-size:24rpx}

.intro{padding:12rpx 0 28rpx;margin-bottom:24rpx;border-bottom:1rpx solid var(--border)}.title{font-size:42rpx;line-height:1.4;font-weight:750}.copy{font-size:26rpx;line-height:1.75}.primary,.secondary{min-height:84rpx;line-height:1.5;padding:20rpx 24rpx;font-size:28rpx}.notice{font-size:26rpx;line-height:1.7}.workspace input{min-height:76rpx;font-size:30rpx}.workspace textarea{font-size:28rpx;line-height:1.7}.pagination{margin-top:28rpx}
