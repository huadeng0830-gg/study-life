.page{padding:24rpx 28rpx 70rpx}.intro{display:grid;gap:10rpx;padding:20rpx 0 24rpx}.eyebrow{font-size:19rpx;letter-spacing:2rpx;color:#067654}.title{font-size:42rpx;font-weight:750;color:#1d312d}.copy{font-size:22rpx;line-height:1.7;color:#596a64}.form{display:grid;gap:14rpx;padding:20rpx;border:1rpx solid #d9e3dd;border-radius:20rpx;background:#fbfdfb}.form-title{font-size:28rpx;font-weight:650}.picker{padding:16rpx 12rpx;background:#f1f5f2;border-radius:12rpx;font-size:23rpx;color:#596a64}.form input,.form textarea{box-sizing:border-box;width:100%;padding:16rpx;border:1rpx solid #d9e3dd;border-radius:12rpx;background:#f8faf8;font-size:24rpx;color:#1d312d}.form textarea{min-height:180rpx}.privacy{font-size:19rpx;line-height:1.7;color:#596a64}.primary{background:#067654;color:#fff;border-radius:14rpx;font-size:25rpx}.notice{margin-top:14rpx;padding:14rpx;border-radius:12rpx;font-size:22rpx}.error{background:#f9ecea;color:#9c4038}.success{background:#e6f3ed;color:#067654}.section-heading{display:flex;justify-content:space-between;align-items:center;margin:32rpx 2rpx 10rpx;font-size:28rpx;font-weight:650}.filter{color:#067654;font-size:22rpx}.state{padding:50rpx 10rpx;color:#596a64;text-align:center;font-size:23rpx}.list{border-top:1rpx solid #d9e3dd}.item{display:grid;gap:12rpx;padding:20rpx 2rpx;border-bottom:1rpx solid #d9e3dd}.meta{display:flex;align-items:center;gap:12rpx;color:#596a64;font-size:20rpx}.status{padding:4rpx 10rpx;border-radius:99rpx;background:#eaf2ed;color:#067654}.item-title{font-size:26rpx;font-weight:650;color:#1d312d}.item-body{white-space:pre-wrap;overflow-wrap:anywhere;font-size:22rpx;line-height:1.7;color:#596a64}.reply{display:grid;gap:5rpx;padding:14rpx;border-left:5rpx solid #067654;background:#f1f5f2;color:#596a64;font-size:21rpx;line-height:1.7;white-space:pre-wrap}.reply-title{font-weight:650;color:#1d312d}
.reward{padding:10rpx 13rpx;border-radius:10rpx;background:#e6f3ed;color:#067654;font-size:20rpx;font-weight:650}