<view class="workspace" style="{{themeStyle}}">
  <view class="intro"><text class="title">反馈与建议</text><text class="copy">公开查看状态、管理员回复和已解决奖励。建议安全检查后匿名展示，不开放评论或投票。</text></view>
  <view class="form">
    <text class="form-title">留下一条建议</text>
    <picker mode="selector" range="{{categoryOptions}}" bindchange="onCategory"><view class="picker">建议分类：{{categoryOptions[category === 'product' ? 0 : category === 'campus' ? 1 : category === 'accessibility' ? 2 : 3]}}</view></picker>
    <input maxlength="100" placeholder="标题：一句话概括你的想法" value="{{title}}" bindinput="onTitle"/>
    <textarea maxlength="3000" placeholder="描述遇到的情况，以及你希望看到的改进…" value="{{body}}" bindinput="onBody"/>
    <text class="privacy">公开页面不显示提交人的账号。管理员可以查看提交记录；联系方式和私人信息不要写入公开内容。</text>
    <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交建议</button>
  </view>
  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view wx:if="{{notice}}" class="notice success">{{notice}}</view>
  <view class="section-heading"><text>公开进度</text><picker mode="selector" range="{{statusOptions}}" bindchange="onStatus"><view class="filter">{{selectedStatus}}⌄</view></picker></view>
  <view wx:if="{{loading}}" class="state">正在读取公开建议…</view><view wx:elif="{{!items.length}}" class="state">暂无公开建议</view>
  <view wx:else class="list">
    <view wx:for="{{items}}" wx:key="id" class="item">
      <view class="meta"><text>{{item.categoryLabel}}</text><text class="status">{{item.statusLabel}}</text><text>匿名同学</text></view>
      <text class="item-title">{{item.title}}</text><text class="item-body">{{item.body}}</text>
      <view wx:if="{{item.reward_issued}}" class="reward">管理员已设置奖励 {{item.reward_beans || 0}} 个贡献豆</view>
      <view wx:if="{{item.public_reply}}" class="reply"><text class="reply-title">管理员回复</text><text>{{item.public_reply}}</text></view>
      <view wx:if="{{item.status === 'not_adopted' && item.public_reason}}" class="reply"><text class="reply-title">暂不采纳说明</text><text>{{item.public_reason}}</text></view>
    </view>
  </view>
  <view class="pagination"><button size="mini" disabled="{{loading || !page}}" bindtap="previousPage">上一页</button><text>第 {{page + 1}} 页</text><button size="mini" disabled="{{loading || !hasMore}}" bindtap="nextPage">下一页</button></view>
</view>
