.week-strip{display:flex;gap:8rpx;justify-content:space-between}.week-day{display:flex;flex:1;flex-direction:column;align-items:center;gap:14rpx;padding:18rpx 0;border-radius:18rpx}.week-day.selected{background:var(--primary-soft);color:var(--primary)}.week-label{font-size:22rpx;color:var(--muted)}.week-date{font-size:30rpx;font-weight:650}.week-dot{width:7rpx;height:7rpx;background:transparent;border-radius:50%}.week-dot.visible{background:var(--primary)}.week-context{display:flex;justify-content:space-between;font-size:22rpx;color:var(--muted);padding:18rpx 0}.course-row{display:flex;gap:22rpx;align-items:center;padding:24rpx 0;border-top:1rpx solid var(--border)}.course-time{display:flex;flex-direction:column;gap:8rpx;width:94rpx;font-size:27rpx;font-weight:650}.course-main{padding-left:22rpx;border-left:5rpx solid var(--primary);min-width:0}
