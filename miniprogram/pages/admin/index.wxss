.page{padding:24rpx 28rpx 70rpx}.intro{display:grid;gap:10rpx;margin-bottom:24rpx}.eyebrow{font-size:24rpx;letter-spacing:2rpx;color:var(--primary)}.title{font-size:42rpx;font-weight:700;color:var(--text)}.copy{display:block;font-size:24rpx;line-height:1.7;color:var(--muted);white-space:pre-wrap;overflow-wrap:anywhere}.box-title{display:block;font-size:27rpx;font-weight:650;color:var(--text)}.item,.form{display:grid;gap:14rpx;width:100%;box-sizing:border-box;text-align:left;margin:18rpx 0;padding:22rpx;background:var(--card);border:1rpx solid var(--border);border-radius:16rpx}.item::after{border:0}.picker,input,textarea{box-sizing:border-box;padding:16rpx;background:var(--bg);border:1rpx solid var(--border);border-radius:10rpx;font-size:24rpx}textarea{width:100%;min-height:160rpx}.actions{display:flex;gap:12rpx;flex-wrap:wrap}.actions button{margin:0;background:var(--primary-soft);color:var(--primary);font-size:24rpx}.notice{padding:14rpx;margin:16rpx 0;border-radius:10rpx;font-size:24rpx}.error{background:#f9ecea;color:#9c4038}.success{background:#e6f3ed;color:var(--primary)}.state{padding:36rpx 0;color:var(--muted)}.pagination{display:flex;align-items:center;gap:16rpx;margin:24rpx 0;font-size:24rpx}.refresh{font-size:24rpx;color:var(--primary)}

.intro{padding:12rpx 0 28rpx;margin-bottom:24rpx;border-bottom:1rpx solid var(--border)}.title{font-size:42rpx;line-height:1.4;font-weight:750}.copy{font-size:26rpx;line-height:1.75}.primary,.secondary{min-height:84rpx;line-height:1.5;padding:20rpx 24rpx;font-size:28rpx}.notice{font-size:26rpx;line-height:1.7}.workspace input{min-height:76rpx;font-size:30rpx}.workspace textarea{font-size:28rpx;line-height:1.7}.pagination{margin-top:28rpx}
