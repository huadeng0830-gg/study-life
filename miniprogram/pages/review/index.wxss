.page{padding:24rpx 28rpx 70rpx}.intro{display:grid;gap:10rpx;padding:18rpx 0 20rpx}.eyebrow{font-size:19rpx;letter-spacing:2rpx;color:#067654}.title{font-size:42rpx;font-weight:750;color:#1d312d}.copy{font-size:22rpx;line-height:1.7;color:#596a64}.notice{margin-bottom:12rpx;padding:13rpx;border-radius:10rpx;font-size:21rpx}.error{background:#f9ecea;color:#9c4038}.state{display:grid;justify-items:center;gap:16rpx;padding:55rpx 18rpx;color:#596a64;text-align:center;font-size:23rpx}.scope{margin-bottom:14rpx;padding:12rpx;border-radius:10rpx;background:#eaf2ed;color:#067654;font-size:22rpx}.review-item{display:grid;gap:13rpx;margin-bottom:15rpx;padding:18rpx;border:1rpx solid #d9e3dd;border-radius:16rpx;background:#fbfdfb}.meta{display:flex;gap:10rpx;align-items:center;flex-wrap:wrap;color:#596a64;font-size:19rpx}.tag{padding:4rpx 9rpx;border-radius:99rpx;background:#eaf2ed;color:#067654}.item-title{font-size:27rpx;font-weight:650;color:#1d312d}.item-copy{font-size:22rpx;line-height:1.7;color:#596a64;white-space:pre-wrap;overflow-wrap:anywhere}.review-item textarea{box-sizing:border-box;width:100%;min-height:130rpx;padding:12rpx;border:1rpx solid #d9e3dd;border-radius:12rpx;font-size:22rpx}.actions{display:flex;flex-wrap:wrap;gap:8rpx}.actions button,.secondary,.refresh{margin:0;background:#eaf2ed;color:#067654;font-size:20rpx}.actions button.danger{background:#f9ecea;color:#9c4038}.refresh{margin-top:18rpx;width:100%;padding:10rpx}.secondary{padding:10rpx 18rpx}
