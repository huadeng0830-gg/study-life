.page{padding:24rpx 28rpx 70rpx}.intro{display:grid;gap:10rpx;padding:18rpx 0 20rpx}.eyebrow{font-size:24rpx;letter-spacing:2rpx;color:var(--primary)}.title{font-size:42rpx;font-weight:750;color:var(--text)}.copy{font-size:24rpx;line-height:1.7;color:var(--muted)}.notice{margin-bottom:12rpx;padding:13rpx;border-radius:10rpx;font-size:24rpx}.error{background:#f9ecea;color:#9c4038}.state{display:grid;justify-items:center;gap:16rpx;padding:55rpx 18rpx;color:var(--muted);text-align:center;font-size:24rpx}.scope{margin-bottom:14rpx;padding:12rpx;border-radius:10rpx;background:var(--primary-soft);color:var(--primary);font-size:24rpx}.review-item{display:grid;gap:13rpx;margin-bottom:15rpx;padding:18rpx;border:1rpx solid var(--border);border-radius:16rpx;background:var(--card)}.meta{display:flex;gap:10rpx;align-items:center;flex-wrap:wrap;color:var(--muted);font-size:24rpx}.tag{padding:4rpx 9rpx;border-radius:99rpx;background:var(--primary-soft);color:var(--primary)}.item-title{font-size:27rpx;font-weight:650;color:var(--text)}.item-copy{font-size:24rpx;line-height:1.7;color:var(--muted);white-space:pre-wrap;overflow-wrap:anywhere}.review-item textarea{box-sizing:border-box;width:100%;min-height:130rpx;padding:12rpx;border:1rpx solid var(--border);border-radius:12rpx;font-size:24rpx}.actions{display:flex;flex-wrap:wrap;gap:8rpx}.actions button,.secondary,.refresh{margin:0;background:var(--primary-soft);color:var(--primary);font-size:24rpx}.actions button.danger{background:#f9ecea;color:#9c4038}.refresh{margin-top:18rpx;width:100%;padding:10rpx}.secondary{padding:10rpx 18rpx}
.pagination{display:flex;align-items:center;gap:16rpx;margin:24rpx 0;color:var(--muted);font-size:24rpx}

.intro{padding:12rpx 0 28rpx;margin-bottom:24rpx;border-bottom:1rpx solid var(--border)}.title{font-size:42rpx;line-height:1.4;font-weight:750}.copy{font-size:26rpx;line-height:1.75}.primary,.secondary{min-height:84rpx;line-height:1.5;padding:20rpx 24rpx;font-size:28rpx}.notice{font-size:26rpx;line-height:1.7}.workspace input{min-height:76rpx;font-size:30rpx}.workspace textarea{font-size:28rpx;line-height:1.7}.pagination{margin-top:28rpx}
