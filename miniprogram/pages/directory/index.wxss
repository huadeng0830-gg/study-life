.page{padding:24rpx 28rpx 70rpx}.state{display:grid;justify-items:center;gap:16rpx;padding:70rpx 20rpx;color:#596a64;font-size:25rpx;text-align:center}.error{color:#a7443d}.rows{border-top:1rpx solid #d9e3dd}.row{display:grid;gap:10rpx;padding:22rpx 4rpx;border-bottom:1rpx solid #d9e3dd}.row-title{font-size:27rpx;font-weight:650;color:#1d312d}.row-copy{font-size:23rpx;line-height:1.7;color:#596a64;white-space:pre-wrap}.row-meta{font-size:19rpx;color:#82918b}.refresh{margin-top:24rpx;background:#eaf2ed;color:#067654;font-size:24rpx}
.notice{margin-bottom:14rpx;padding:13rpx;border-radius:10rpx;font-size:21rpx}.notice.error{background:#f9ecea;color:#9c4038}.notice.success{background:#e6f3ed;color:#067654}.report-link{justify-self:end;padding:4rpx 10rpx;background:#f1f5f2;color:#596a64;font-size:19rpx}.report-sheet{position:fixed;z-index:5;left:22rpx;right:22rpx;bottom:24rpx;display:grid;gap:14rpx;padding:22rpx;border:1rpx solid #d9e3dd;border-radius:20rpx;background:#fbfdfb;box-shadow:0 12rpx 50rpx #1d312d33}.sheet-head{display:flex;justify-content:space-between;align-items:center;font-size:27rpx;font-weight:650}.close{font-size:21rpx;font-weight:400;color:#067654}.report-title{font-size:23rpx;color:#596a64}.picker{padding:15rpx;border-radius:11rpx;background:#f1f5f2;color:#596a64;font-size:22rpx}.report-sheet textarea{box-sizing:border-box;width:100%;min-height:135rpx;padding:13rpx;border:1rpx solid #d9e3dd;border-radius:11rpx;font-size:22rpx}.primary{background:#067654;color:#fff;font-size:24rpx}
