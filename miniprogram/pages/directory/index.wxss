.page{padding:24rpx 28rpx 70rpx}.state{display:grid;justify-items:center;gap:16rpx;padding:70rpx 20rpx;color:var(--muted);font-size:25rpx;text-align:center}.error{color:#a7443d}.rows{border-top:1rpx solid var(--border)}.row{display:grid;gap:10rpx;padding:22rpx 4rpx;border-bottom:1rpx solid var(--border)}.row-title{font-size:27rpx;font-weight:650;color:var(--text)}.row-copy{font-size:24rpx;line-height:1.7;color:var(--muted);white-space:pre-wrap}.row-meta{font-size:24rpx;color:var(--muted)}.refresh{margin-top:24rpx;background:var(--primary-soft);color:var(--primary);font-size:24rpx}
.notice{margin-bottom:14rpx;padding:13rpx;border-radius:10rpx;font-size:24rpx}.notice.error{background:#f9ecea;color:#9c4038}.notice.success{background:#e6f3ed;color:var(--primary)}.report-link{justify-self:end;padding:4rpx 10rpx;background:var(--bg);color:var(--muted);font-size:24rpx}.report-sheet{position:fixed;z-index:5;left:22rpx;right:22rpx;bottom:24rpx;display:grid;gap:14rpx;padding:22rpx;border:1rpx solid var(--border);border-radius:20rpx;background:var(--card);box-shadow:0 12rpx 50rpx rgba(23,32,51,.2)}.sheet-head{display:flex;justify-content:space-between;align-items:center;font-size:27rpx;font-weight:650}.close{font-size:24rpx;font-weight:400;color:var(--primary)}.report-title{font-size:24rpx;color:var(--muted)}.picker{padding:15rpx;border-radius:11rpx;background:var(--bg);color:var(--muted);font-size:24rpx}.report-sheet textarea{box-sizing:border-box;width:100%;min-height:135rpx;padding:13rpx;border:1rpx solid var(--border);border-radius:11rpx;font-size:24rpx}.primary{background:var(--primary);color:#fff;font-size:24rpx}
.pagination{display:flex;align-items:center;gap:16rpx;margin:24rpx 0;color:var(--muted);font-size:24rpx}.post-title{box-sizing:border-box;width:100%;padding:16rpx;border:1rpx solid var(--border);border-radius:10rpx;background:var(--card);font-size:24rpx}

.intro{padding:12rpx 0 28rpx;margin-bottom:24rpx;border-bottom:1rpx solid var(--border)}.title{font-size:42rpx;line-height:1.4;font-weight:750}.copy{font-size:26rpx;line-height:1.75}.primary,.secondary{min-height:84rpx;line-height:1.5;padding:20rpx 24rpx;font-size:28rpx}.notice{font-size:26rpx;line-height:1.7}.workspace input{min-height:76rpx;font-size:30rpx}.workspace textarea{font-size:28rpx;line-height:1.7}.pagination{margin-top:28rpx}
