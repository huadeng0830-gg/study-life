.page{padding:24rpx 28rpx 70rpx}.intro{display:grid;gap:10rpx;padding:18rpx 0 20rpx}.eyebrow{font-size:24rpx;letter-spacing:2rpx;color:var(--primary)}.title{font-size:42rpx;font-weight:750;color:var(--text)}.copy{font-size:24rpx;line-height:1.7;color:var(--muted)}.account-box{display:grid;gap:13rpx;margin-bottom:16rpx;padding:20rpx;border:1rpx solid var(--border);border-radius:18rpx;background:var(--card)}.identity{display:flex;align-items:center;justify-content:space-between}.identity>view{display:grid;gap:5rpx}.box-title{font-size:27rpx;font-weight:650;color:var(--text)}.account-box input,.account-box textarea{box-sizing:border-box;width:100%;padding:15rpx;border:1rpx solid var(--border);border-radius:12rpx;background:var(--card);font-size:24rpx}.account-box textarea{min-height:140rpx}.primary,.secondary{background:var(--primary);color:#fff;font-size:24rpx;border-radius:12rpx}.secondary{background:var(--primary-soft);color:var(--primary)}.text-button{color:var(--primary);background:transparent;font-size:24rpx}.divider{text-align:center;color:var(--muted);font-size:24rpx}.balances{display:grid;grid-template-columns:1fr 1fr;gap:10rpx}.balances>view{display:grid;gap:8rpx;padding:14rpx;border-radius:12rpx;background:var(--bg);color:var(--muted);font-size:24rpx}.bean-value{font-size:36rpx;font-weight:700;color:var(--text)}.debt{font-size:24rpx;color:#8a5a12}.notice{margin-bottom:12rpx;padding:13rpx;border-radius:10rpx;font-size:24rpx}.notice.error{background:#f9ecea;color:#9c4038}.notice.success{background:#e6f3ed;color:var(--primary)}.application-status{padding:10rpx 12rpx;border-radius:10rpx;background:var(--primary-soft);color:var(--primary);font-size:24rpx}

.bean-rules,.bean-ledger{display:grid;gap:11rpx;padding:14rpx;border:1rpx solid var(--border);border-radius:13rpx;background:var(--card)}.ledger-title{font-size:24rpx;font-weight:650;color:var(--text)}.bean-rules>.copy{font-size:24rpx;line-height:1.75}.ledger-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:7rpx;padding:11rpx 0;border-bottom:1rpx solid #e3eae5}.ledger-copy{display:grid;gap:4rpx;min-width:0}.ledger-entry{font-size:24rpx;font-weight:600;color:var(--text)}.ledger-copy .copy{font-size:24rpx;line-height:1.5;overflow-wrap:anywhere}.ledger-amount{font-size:24rpx;font-weight:650;white-space:nowrap}.ledger-amount.positive{color:var(--primary)}.ledger-amount.negative{color:#8a5a12}.ledger-row .debt{grid-column:1/-1;margin:0}.empty{padding:15rpx 4rpx;color:var(--muted);font-size:24rpx}
.intro{padding:12rpx 0 28rpx;margin-bottom:24rpx;border-bottom:1rpx solid var(--border)}.title{font-size:42rpx;line-height:1.4;font-weight:750}.copy{font-size:26rpx;line-height:1.75}.primary,.secondary{min-height:84rpx;line-height:1.5;padding:20rpx 24rpx;font-size:28rpx}.notice{font-size:26rpx;line-height:1.7}.workspace input{min-height:76rpx;font-size:30rpx}.workspace textarea{font-size:28rpx;line-height:1.7}.pagination{margin-top:28rpx}
