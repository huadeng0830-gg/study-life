.page{padding:24rpx 28rpx 70rpx}.intro{display:grid;gap:10rpx;padding:18rpx 0 20rpx}.eyebrow{font-size:19rpx;letter-spacing:2rpx;color:#067654}.title{font-size:42rpx;font-weight:750;color:#1d312d}.copy{font-size:21rpx;line-height:1.7;color:#596a64}.account-box{display:grid;gap:13rpx;margin-bottom:16rpx;padding:20rpx;border:1rpx solid #d9e3dd;border-radius:18rpx;background:#fbfdfb}.identity{display:flex;align-items:center;justify-content:space-between}.identity>view{display:grid;gap:5rpx}.box-title{font-size:27rpx;font-weight:650;color:#1d312d}.account-box input,.account-box textarea{box-sizing:border-box;width:100%;padding:15rpx;border:1rpx solid #d9e3dd;border-radius:12rpx;background:#f8faf8;font-size:23rpx}.account-box textarea{min-height:140rpx}.primary,.secondary{background:#067654;color:#fff;font-size:24rpx;border-radius:12rpx}.secondary{background:#eaf2ed;color:#067654}.text-button{color:#067654;background:transparent;font-size:21rpx}.divider{text-align:center;color:#80918a;font-size:20rpx}.balances{display:grid;grid-template-columns:1fr 1fr;gap:10rpx}.balances>view{display:grid;gap:8rpx;padding:14rpx;border-radius:12rpx;background:#f1f5f2;color:#596a64;font-size:21rpx}.bean-value{font-size:36rpx;font-weight:700;color:#1d312d}.debt{font-size:20rpx;color:#8a5a12}.notice{margin-bottom:12rpx;padding:13rpx;border-radius:10rpx;font-size:21rpx}.notice.error{background:#f9ecea;color:#9c4038}.notice.success{background:#e6f3ed;color:#067654}.application-status{padding:10rpx 12rpx;border-radius:10rpx;background:#eaf2ed;color:#067654;font-size:22rpx}

.bean-rules,.bean-ledger{display:grid;gap:11rpx;padding:14rpx;border:1rpx solid #d9e3dd;border-radius:13rpx;background:#fbfdfb}.ledger-title{font-size:23rpx;font-weight:650;color:#1d312d}.bean-rules>.copy{font-size:20rpx;line-height:1.75}.ledger-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:7rpx;padding:11rpx 0;border-bottom:1rpx solid #e3eae5}.ledger-copy{display:grid;gap:4rpx;min-width:0}.ledger-entry{font-size:21rpx;font-weight:600;color:#1d312d}.ledger-copy .copy{font-size:18rpx;line-height:1.5;overflow-wrap:anywhere}.ledger-amount{font-size:20rpx;font-weight:650;white-space:nowrap}.ledger-amount.positive{color:#067654}.ledger-amount.negative{color:#8a5a12}.ledger-row .debt{grid-column:1/-1;margin:0}.empty{padding:15rpx 4rpx;color:#596a64;font-size:21rpx}