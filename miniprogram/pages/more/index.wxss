.account-entry{display:flex;align-items:center;gap:22rpx;padding:28rpx;border:1rpx solid var(--border);background:#fff;border-radius:24rpx;margin-bottom:32rpx}.account-mark{width:86rpx;height:86rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:var(--primary-soft);color:var(--primary);font-size:38rpx;font-weight:700}.chevron{font-size:38rpx;color:#8490a5}.menu-group{margin-bottom:30rpx}.group-title{display:block;font-size:24rpx;font-weight:600;color:var(--muted);margin:0 8rpx 16rpx}.menu-panel{border:1rpx solid var(--border);border-radius:24rpx;padding:0 24rpx;background:#fff}.menu-row{display:flex;align-items:center;gap:22rpx;min-height:108rpx;border-bottom:1rpx solid var(--border)}.menu-row:last-child{border:0}.menu-label{flex:1;font-size:28rpx}.footnote{display:block;text-align:center;font-size:22rpx;color:var(--muted);line-height:1.9}
