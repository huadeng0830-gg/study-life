.page{padding:32rpx 28rpx 80rpx}.hero{display:flex;flex-direction:column;gap:16rpx;padding:34rpx 28rpx;border:1rpx solid #d9e3dd;border-radius:28rpx;background:#fbfdfb}.eyebrow{font-size:20rpx;font-weight:650;letter-spacing:2rpx;color:#067654}.hero-title{white-space:pre-line;font-size:48rpx;font-weight:750;line-height:1.3;color:#1d312d}.hero-copy{font-size:25rpx;line-height:1.7;color:#596a64}.primary{width:100%;margin-top:10rpx;color:#fff;background:#067654;border-radius:16rpx;font-size:27rpx}.section-heading{display:flex;justify-content:space-between;align-items:center;margin:38rpx 4rpx 16rpx;font-weight:650;font-size:29rpx}.muted,.footnote{color:#596a64;font-size:22rpx}.link-list{border-top:1rpx solid #d9e3dd}.link-row{display:flex;align-items:center;justify-content:space-between;width:100%;padding:24rpx 6rpx;border-bottom:1rpx solid #d9e3dd;background:transparent;text-align:left}.link-row>text:first-child{display:grid;gap:8rpx}.link-title{font-size:27rpx;font-weight:650;color:#1d312d}.link-note{font-size:22rpx;color:#596a64}.arrow{font-size:44rpx;color:#80918a}.footnote{margin-top:28rpx;line-height:1.7}
