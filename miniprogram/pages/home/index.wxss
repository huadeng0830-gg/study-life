.page-heading{font-size:42rpx;line-height:1.5}.quick-entry,.focus-entry{display:flex;align-items:center;gap:20rpx;padding:24rpx;background:#fff;border:1rpx solid var(--border);border-radius:22rpx;margin-bottom:26rpx}.quick-plus{font-size:44rpx;color:var(--primary);width:54rpx;text-align:center}.quick-arrow{font-size:40rpx;color:#8490a5}.overview{display:grid;grid-template-columns:1fr 1fr 1.4fr;padding:4rpx 14rpx 28rpx;gap:14rpx}.overview>view{display:flex;flex-direction:column;gap:4rpx}.next-panel{padding:30rpx;background:var(--primary-soft);border-radius:24rpx;border:1rpx solid #dce5ff;display:grid;gap:12rpx;margin-bottom:24rpx}.next-label{font-size:23rpx;color:var(--primary);font-weight:600}.next-title{font-size:36rpx;font-weight:700;line-height:1.45}.next-meta{font-size:25rpx;color:var(--muted);line-height:1.7}.next-panel button{margin:12rpx 0 0;justify-self:start}.agenda-row{display:flex;gap:20rpx;align-items:flex-start;min-height:112rpx;padding-top:8rpx}.agenda-time{width:84rpx;font-size:24rpx;font-weight:600;padding-top:3rpx}.agenda-track{position:relative;width:1rpx;align-self:stretch;background:var(--border);margin:10rpx 8rpx 0}.agenda-track::before{content:"";position:absolute;width:12rpx;height:12rpx;border-radius:50%;background:var(--primary);left:-6rpx;top:0}.ended{opacity:.6}.overdue{color:var(--danger)}.days-left{display:flex;gap:8rpx;align-items:baseline;color:var(--primary);font-size:44rpx;font-weight:750}.finance-stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18rpx;margin:16rpx 0 22rpx}.finance-stats>view{display:flex;flex-direction:column;gap:12rpx}.finance-number{font-size:34rpx;font-weight:700}.mood-options{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:24rpx}.mood{margin:0;font-size:24rpx;padding:14rpx 20rpx;line-height:1.6;border:1rpx solid var(--border);border-radius:99rpx;background:#fff;color:var(--muted)}.mood.chosen{color:var(--primary);border-color:var(--primary);background:var(--primary-soft)}.review-link{display:flex;align-items:center;justify-content:space-between;padding:10rpx 6rpx;color:var(--muted)}
