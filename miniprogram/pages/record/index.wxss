.capture-panel{border:1rpx solid #d3dbea;border-radius:24rpx;background:#fff;padding:26rpx;margin-bottom:28rpx}.capture-input{width:100%;height:290rpx;font-size:31rpx;line-height:1.8;color:var(--text)}.capture-footer{display:flex;justify-content:space-between;align-items:center;padding-top:20rpx;border-top:1rpx solid var(--border)}.type-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16rpx;margin:30rpx 0}.type-button{display:flex;flex-direction:column;align-items:center;gap:14rpx;background:#fff;border:1rpx solid var(--border);border-radius:20rpx;margin:0;padding:24rpx 6rpx;font-size:23rpx;line-height:1.5;color:var(--muted)}.type-button.selected{border-color:var(--primary);color:var(--primary);background:var(--primary-soft)}.capture-hint{display:block;margin:20rpx 4rpx 32rpx;font-size:23rpx;line-height:1.8;color:var(--muted)}
