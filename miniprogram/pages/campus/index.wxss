.campus-search{display:flex;gap:18rpx;align-items:center;background:#fff;border:1rpx solid var(--border);padding:24rpx;border-radius:18rpx;margin-bottom:28rpx}.campus-search input{flex:1;min-width:0;font-size:29rpx}.service-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.service-card{background:#fff;border:1rpx solid var(--border);border-radius:22rpx;padding:28rpx;display:flex;flex-direction:column;gap:14rpx}.service-title{font-size:29rpx;font-weight:650;margin-top:7rpx}.service-note{font-size:23rpx;line-height:1.65;color:var(--muted)}.personal-links{display:flex;justify-content:space-between;margin:30rpx 6rpx}.community-link{display:flex;align-items:center;gap:16rpx;padding:28rpx;background:#fff;border:1rpx solid var(--border);border-radius:22rpx;margin-bottom:26rpx}.community-link .text-link{max-width:160rpx}
