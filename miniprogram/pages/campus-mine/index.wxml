<view class="workspace" style="{{themeStyle}}"><view class="page-header"><view><text class="page-heading">我的校园记录</text><text class="subtitle">查看审核进度、修改投稿和举报处理结果。</text></view></view><view class="chip-list"><button class="chip {{mode === 'mine_list' ? 'active' : ''}}" data-mode="mine_list" bindtap="mode">我的投稿</button><button class="chip {{mode === 'reports_mine' ? 'active' : ''}}" data-mode="reports_mine" bindtap="mode">我的举报</button></view><view wx:if="{{error}}" class="notice error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view class="panel"><view wx:if="{{!items.length}}" class="empty">当前没有记录。</view><view wx:for="{{items}}" wx:key="id" class="entry"><text class="record-title">{{item.title || item.reason}}</text><text class="record-meta">{{item.statusLabel}} · {{item.school}} {{item.campus}}</text><text class="body-copy">{{item.body || item.detail}}</text><text wx:if="{{item.resolution}}" class="notice">处理依据：{{item.resolution}}</text><view wx:if="{{mode === 'mine_list' && item.status !== 'removed'}}" class="form-actions"><button class="action-secondary compact-button" data-id="{{item.id}}" bindtap="select">修改并重新审核</button><button wx:if="{{item.status !== 'withdrawn'}}" class="action-secondary compact-button" data-id="{{item.id}}" bindtap="withdraw">撤回</button></view></view></view>
  <view wx:if="{{selected}}" class="panel"><text class="section-title">修改投稿</text><input class="field-input" maxlength="100" data-key="title" value="{{title}}" bindinput="input"/><textarea class="field-textarea" maxlength="3000" data-key="body" value="{{body}}" bindinput="input"/><button class="action-primary" disabled="{{busy}}" loading="{{busy}}" bindtap="save">重新提交审核</button></view><view class="form-actions"><button class="action-secondary" disabled="{{!page}}" bindtap="previous">上一页</button><button class="action-secondary" disabled="{{!hasMore}}" bindtap="next">下一页</button></view>
</view>
