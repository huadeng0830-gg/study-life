.theme-options{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.theme-option{display:flex;align-items:center;gap:16rpx;padding:22rpx;background:#fff;border:1rpx solid var(--border);border-radius:16rpx;margin:0;line-height:1.6;font-size:26rpx}.theme-option.selected{border-color:currentColor}.theme-dot{width:30rpx;height:30rpx;border-radius:50%}
