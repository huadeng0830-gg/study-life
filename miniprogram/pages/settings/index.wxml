<view class="workspace" style="{{themeStyle}}"><view class="page-header"><view><text class="page-heading">外观与学期</text><text class="subtitle">沿用网页版的主题色和学期概念。</text></view></view><view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view class="panel"><text class="field-label">主题颜色</text><view class="theme-options"><button wx:for="{{themes}}" wx:key="key" class="theme-option {{values.theme === item.key ? 'selected' : ''}}" style="color:{{item.color}}" data-theme="{{item.key}}" bindtap="theme"><view class="theme-dot" style="background:{{item.color}}"/><text>{{item.label}}</text><text>{{values.theme === item.key ? '✓' : ''}}</text></button></view></view>
  <view class="panel"><view class="form-field"><text class="field-label">学期第一周周一</text><picker mode="date" value="{{values.termStart}}" data-key="termStart" bindchange="input"><view class="field-picker">{{values.termStart || '选择日期'}} ▾</view></picker><text class="field-hint">用于课表的周次、单双周和课程起止周判断。</text><text wx:if="{{values.termStart}}" class="text-link" bindtap="clearTerm">暂不设置周次</text></view><view class="form-field"><text class="field-label">当前校区</text><input class="field-input" maxlength="80" data-key="campus" value="{{values.campus}}" bindinput="input" placeholder="例如：主校区"/></view><view class="form-field"><text class="field-label">作息名称</text><input class="field-input" maxlength="60" data-key="season" value="{{values.season}}" bindinput="input" placeholder="例如：秋季作息"/></view></view>
  <view class="panel"><text class="field-label">月度预算（人民币）</text><input class="field-input" type="digit" data-key="budget" value="{{budget}}" bindinput="input" placeholder="留空表示不设置预算"/><text class="field-hint">按账本中的人民币支出计算，其他币种单独展示。</text></view><button class="action-primary" bindtap="save">保存设置</button>
</view>
