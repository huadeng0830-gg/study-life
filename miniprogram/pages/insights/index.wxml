<view class="workspace" style="{{themeStyle}}"><view class="page-header"><view><text class="page-heading">回顾</text><text class="subtitle">看看自己把时间放在了哪里。</text></view><picker mode="date" fields="month" value="{{month + '-01'}}" bindchange="month"><text class="text-link">{{month}} ▾</text></picker></view>
  <view class="two-columns"><view class="panel"><text class="metric-label">完成待办</text><text class="metric">{{stats.completed}}</text></view><view class="panel"><text class="metric-label">专注分钟</text><text class="metric">{{stats.focusMinutes}}</text></view><view class="panel"><text class="metric-label">本月支出 CNY</text><text class="metric">{{stats.expense}}</text></view><view class="panel"><text class="metric-label">本月收入 CNY</text><text class="metric">{{stats.income}}</text></view></view>
  <view class="panel"><view class="panel-heading"><text class="section-title">每天的一点积累</text><text class="small-copy">{{stats.focusCount}} 次专注</text></view><view class="month-grid"><view wx:for="{{days}}" wx:key="date" class="day-cell {{item.active ? 'active' : ''}}"><text class="day-label">{{item.label}}</text><text class="day-detail">{{item.minutes ? item.minutes + 'm' : item.mood || '—'}}</text></view></view></view>
  <view class="panel"><view class="panel-heading"><text class="section-title">最近专注</text></view><view wx:if="{{!recent.length}}" class="empty">这个月还没有专注记录。</view><view wx:for="{{recent}}" wx:key="id" class="record-row"><view class="record-main"><text class="record-title">{{item.title}}</text><text class="record-meta">{{item.meta}}</text><text wx:if="{{item.note}}" class="body-copy">{{item.note}}</text></view></view></view><text class="sync-line">{{sync.label}}</text>
</view>
