.month-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:10rpx}.day-cell{display:flex;flex-direction:column;align-items:center;gap:9rpx;padding:14rpx 2rpx;border-radius:13rpx;background:#f5f7fb;min-height:68rpx}.day-cell.active{background:var(--primary-soft);color:var(--primary)}.day-label{font-size:25rpx;font-weight:600}.day-detail{font-size:18rpx;color:var(--muted)}.metric{font-size:36rpx}
