/* 对齐网页版 DESIGN_TOKENS.md：蓝色主题、浅灰工作区、白色面板。 */
/* v2 原生按钮默认有固定宽度；由容器布局决定宽度，避免撑破网格。 */
.workspace button{width:auto;min-width:0;margin-left:0;margin-right:0}
.workspace .action-primary,.workspace .action-secondary{width:100%}
.workspace .compact-button{width:auto;flex-shrink:0}
page{--bg:#f5f7fb;--card:#fff;--text:#172033;--muted:#667085;--primary:#3d63d8;--primary-soft:#edf2ff;--border:#e3e8f2;--danger:#c62828;--success:#067654;background:#f5f7fb;color:#172033;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx}
.workspace{padding:28rpx 28rpx 210rpx;min-height:100vh;box-sizing:border-box;background:var(--bg);color:var(--text)}
.page-header{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:12rpx 0 30rpx;border-bottom:1rpx solid var(--border);margin-bottom:28rpx}.page-heading{font-size:44rpx;line-height:1.35;font-weight:750;letter-spacing:-1rpx}.subtitle{display:block;margin-top:10rpx;font-size:25rpx;color:var(--muted);line-height:1.6}.date-line{display:flex;align-items:center;gap:12rpx;flex-wrap:wrap;margin-top:14rpx;color:var(--muted);font-size:24rpx}.pill{display:inline-block;padding:5rpx 12rpx;border:1rpx solid var(--border);border-radius:99rpx;background:var(--card);font-size:22rpx;color:var(--muted)}
.panel{background:var(--card);border:1rpx solid var(--border);border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}.panel-heading{display:flex;justify-content:space-between;align-items:center;gap:12rpx;margin-bottom:20rpx}.section-title{font-weight:700;font-size:30rpx}.text-link{font-size:24rpx;color:var(--primary);background:transparent;padding:0;margin:0;line-height:1.8}.body-copy{font-size:26rpx;line-height:1.75;color:var(--muted)}.small-copy{font-size:23rpx;line-height:1.6;color:var(--muted)}
button{font-size:28rpx;box-sizing:border-box}button::after{border:0}.action-primary{border-radius:16rpx;background:var(--primary);color:#fff;min-height:88rpx;line-height:1.4;padding:24rpx 28rpx;font-weight:600}.action-secondary{border-radius:16rpx;background:var(--primary-soft);color:var(--primary);min-height:84rpx;line-height:1.4;padding:22rpx 26rpx}.action-danger{background:#fff0f0;color:var(--danger);border-radius:16rpx;padding:22rpx}.compact-button{min-height:72rpx;font-size:25rpx;padding:18rpx 24rpx;white-space:nowrap}.icon{width:40rpx;height:40rpx;flex-shrink:0}.icon-box{display:flex;align-items:center;justify-content:center;background:var(--primary-soft);width:76rpx;height:76rpx;border-radius:20rpx;flex-shrink:0}
.record-row{display:flex;align-items:center;gap:20rpx;padding:24rpx 0;border-top:1rpx solid var(--border)}.record-row:first-child{border-top:0}.record-main{flex:1;min-width:0}.record-title{display:block;font-weight:600;font-size:28rpx;line-height:1.6;overflow-wrap:anywhere}.record-meta{display:block;color:var(--muted);font-size:23rpx;line-height:1.6;margin-top:5rpx}.record-check{width:40rpx;height:40rpx;border:2rpx solid #b9c4da;border-radius:12rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:26rpx}.record-check.checked{background:var(--primary-soft);border-color:var(--primary)}.completed .record-title{text-decoration:line-through;color:var(--muted)}.row-action{padding:12rpx 0 12rpx 16rpx;background:transparent;color:var(--primary);font-size:24rpx;margin:0}.row-danger{color:var(--danger)}.empty{padding:32rpx 12rpx;text-align:center;color:var(--muted);font-size:26rpx;line-height:1.8}.empty-title{display:block;color:var(--text);font-weight:600;margin-bottom:10rpx}.empty .action-secondary{margin-top:24rpx}.notice{padding:22rpx 24rpx;margin:0 0 24rpx;border-radius:16rpx;background:var(--primary-soft);color:var(--primary);font-size:25rpx;line-height:1.6}.notice.error{background:#fff0f0;color:var(--danger)}.sync-line{font-size:22rpx;color:var(--muted);margin:20rpx 0;line-height:1.6}.sync-line.warning{color:#8a5a12}
.form-field{margin-bottom:28rpx}.field-label{display:block;font-size:26rpx;font-weight:600;margin-bottom:14rpx}.field-input,.field-picker,.field-textarea{width:100%;box-sizing:border-box;border:1rpx solid #d3dbea;border-radius:16rpx;background:#fff;padding:22rpx 24rpx;font-size:30rpx;color:var(--text);min-height:88rpx}.field-textarea{min-height:230rpx;line-height:1.7}.field-hint{display:block;font-size:23rpx;color:var(--muted);margin-top:10rpx;line-height:1.6}.form-actions{display:flex;gap:20rpx;margin-top:32rpx}.form-actions button{flex:1}.two-columns{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.metric{display:block;font-size:42rpx;font-weight:750;line-height:1.5}.metric-label{font-size:23rpx;color:var(--muted)}.chip-list{display:flex;gap:14rpx;flex-wrap:wrap;margin-bottom:24rpx}.chip{margin:0;padding:14rpx 24rpx;line-height:1.6;border-radius:99rpx;background:#fff;border:1rpx solid var(--border);color:var(--muted);font-size:25rpx}.chip.active{background:var(--primary-soft);border-color:var(--primary);color:var(--primary)}.divider{height:1rpx;background:var(--border);margin:24rpx 0}.amount-expense{color:var(--danger)}.amount-income{color:var(--success)}
