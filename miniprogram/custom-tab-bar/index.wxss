.tab-bar{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:50;background:#fff;border-top:1rpx solid #e3e8f2;padding:14rpx 12rpx calc(14rpx + env(safe-area-inset-bottom));box-shadow:0 -6rpx 28rpx rgba(23,32,51,.035)}.tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:6rpx;color:#667085;min-height:92rpx;padding:5rpx 0;box-sizing:border-box}.tab-icon{display:flex;align-items:center;justify-content:center;width:64rpx;height:50rpx;border-radius:16rpx}.icon-image{width:42rpx;height:42rpx;opacity:.65}.tab-label{font-size:22rpx;line-height:1.5}.active{color:var(--primary);font-weight:650}.active .tab-icon{background:#edf2ff}.active .icon-image{opacity:1}.capture .tab-icon{height:58rpx;width:74rpx;background:#edf2ff;margin-top:-8rpx}.capture .icon-image{opacity:1}
