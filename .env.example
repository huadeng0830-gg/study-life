# Supabase 浏览器配置：填写项目 URL 和 publishable key，禁止使用 secret / service_role key。
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Only list providers already enabled in Supabase with their own OAuth app.
VITE_ACCOUNT_OAUTH_PROVIDERS=
# Keep false until a production SMTP service is configured and tested.
VITE_ACCOUNT_EMAIL_SIGNUP_ENABLED=false
VITE_ACCOUNT_EMAIL_DELIVERY_ENABLED=false
# Optional Cloudflare Workers public API origin. Blank uses the existing APIs.
VITE_PUBLIC_API_URL=
